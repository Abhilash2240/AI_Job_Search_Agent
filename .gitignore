# ==============================================================================
# AI Job Search Agent — Root .gitignore
# ==============================================================================

# ── 1. Secrets & Environment Configurations ──────────────────────────────────
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
*.env
*.env.local

# ── 2. Local Databases & SQLite ──────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal
*.db-journal
ai_job_search.db
backend/ai_job_search.db

# ── 3. Dependencies & Package Managers ───────────────────────────────────────
node_modules/
frontend/node_modules/
package-lock.json
pnpm-lock.yaml
yarn.lock

# ── 4. Python Bytecode, Caches & Virtual Envs ─────────────────────────────────
__pycache__/
*/__pycache__/
*/*/__pycache__/
*/*/*/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.venv/
venv/
env/
ENV/

# ── 5. Frontend Production Builds ────────────────────────────────────────────
dist/
build/
frontend/dist/
frontend/build/
.next/
out/

# ── 6. OS & IDE Metadata ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo

# ── 7. Temporary Logs & Debug Output ─────────────────────────────────────────
*.log
logs/
*.pid
npm-debug.log*
yarn-debug.log*
yarn-error.log*
