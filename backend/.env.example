# backend/.env.example
# AI Job Search Agent - Environment Configuration

# Provider API Keys
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
GREENHOUSE_API_KEY=your_optional_greenhouse_key_here
LEVER_API_KEY=your_optional_lever_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Job Discovery Runtime Controls
DISCOVERY_MAX_CONCURRENCY=5
DISCOVERY_REQUEST_TIMEOUT=15.0
DISCOVERY_RETRY_LIMIT=3
DISCOVERY_RATE_LIMIT=3.0
DISCOVERY_BATCH_SIZE=25
DISCOVERY_USER_AGENT=AI-Job-Search-Agent-Discovery/1.0

# Database URL (SQLite default)
DATABASE_URL=sqlite+aiosqlite:///./ai_job_search.db
