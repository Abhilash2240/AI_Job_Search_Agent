# ==============================================================================
# AI Job Search Agent — Production Environment Configuration Template
# ==============================================================================

# Application Branding & Environment
PROJECT_NAME="AI Job Search Agent"
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api

# Database Configuration (SQLite default; PostgreSQL compatible)
DATABASE_URL=sqlite+aiosqlite:///backend/ai_job_search.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_job_search

# Local SBERT Model Path (Fine-tuned 384-dimensional model)
SBERT_MODEL_PATH=backend/models/trained_sbert

# CORS Configuration (Comma-separated origins for production)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Candidate Outreach & Privacy Policy Safeguards
ENABLE_AUTOMATED_OUTREACH=false
REQUIRE_EXPLICIT_OUTREACH_AUTHORIZATION=true

# Optional Integrations
FIRECRAWL_API_KEY=
GREENHOUSE_API_KEY=
LEVER_API_KEY=

